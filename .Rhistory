beaches <- search_packages("Toronto Beaches Water Quality") |>
list_package_resources() |>
filter(format == "CSV") |>
head(1) |>
get_resource()
glimpse(beaches)
beaches |>
summarise(
n = n(),
missing_ecoli = sum(is.na(eColi)),
first = min(collectionDate),
last = max(collectionDate)
)
beaches |> count(beachName, sort = TRUE)
library(lubridate)
library(lubridate)
beaches |>
filter(!is.na(eColi)) |>
mutate(year = year(as.Date(collectionDate))) |>
summarise(median_ecoli = median(eColi), .by = year) |>
ggplot(aes(x = year, y = median_ecoli)) +
geom_line() +
geom_point() +
theme_minimal() +
labs(x = "Year", y = "Median E. coli (CFU/100 mL)")
beaches |>
filter(!is.na(eColi)) |>
mutate(month = floor_date(as.Date(collectionDate), "month")) |>
summarise(mean_ecoli = mean(eColi), .by = month) |>
ggplot(aes(x = month, y = mean_ecoli)) +
geom_col() +
theme_minimal() +
labs(x = "Month", y = "Mean E. coli (CFU/100 mL)")
beaches |>
filter(!is.na(eColi), collectionDate >= "2009-01-01", collectionDate < "2009-12-31") |>
arrange(desc(eColi)) |>
select(collectionDate, beachName, eColi) |>
head(20)
beaches |>
filter(!is.na(eColi)) |>
mutate(month = floor_date(as.Date(collectionDate), "month")) |>
summarise(mean_ecoli = mean(eColi), .by = month) |>
ggplot(aes(x = month, y = mean_ecoli)) +
geom_col() +
theme_minimal() +
labs(x = "Month", y = "Mean E. coli (CFU/100 mL)") +
scale_y_log10()
beaches |>
filter(!is.na(eColi)) |>
filter(!is.na(eColi), eColi < 100000) |>
mutate(month = floor_date(as.Date(collectionDate), "month")) |>
summarise(mean_ecoli = mean(eColi), .by = month) |>
ggplot(aes(x = month, y = mean_ecoli)) +
geom_col() +
theme_minimal() +
labs(x = "Month", y = "Mean E. coli (CFU/100 mL)")
clean_beaches <- beaches |>
filter(!is.na(eColi), eColi < 100000) |>
mutate(date = as.Date(collectionDate))
# 1) Average by year
clean_beaches |>
summarise(mean_ecoli = mean(eColi), .by = year(date)) |>
rename(year = `year(date)`) |>
ggplot(aes(x = year, y = mean_ecoli)) +
geom_col() +
theme_minimal() +
labs(x = "Year", y = "Mean E. coli (CFU/100 mL)")
clean_beaches |>
mutate(year = lubridate::year(date)) |>
summarise(mean_ecoli = mean(eColi), .by = year) |>
ggplot(aes(x = year, y = mean_ecoli)) +
geom_col() +
theme_minimal() +
labs(x = "Year", y = "Mean E. coli (CFU/100 mL)")
clean_beaches |>
mutate(week = isoweek(date)) |>
summarise(mean_ecoli = mean(eColi), .by = week) |>
ggplot(aes(x = week, y = mean_ecoli)) +
geom_col() +
theme_minimal() +
labs(x = "Week of year", y = "Mean E. coli (CFU/100 mL)")
clean_beaches |>
mutate(year = lubridate::year(date)) |>
summarise(mean_ecoli = mean(eColi), .by = c(year, beachName)) |>
ggplot(aes(x = year, y = mean_ecoli)) +
geom_line() +
facet_wrap(vars(beachName)) +
theme_minimal()
