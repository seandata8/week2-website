glimpse(wards)
ward_bins <- raccoons |>
summarise(mean_bins = mean(bins_compromised), .by = ward_id)
wards |>
mutate(ward_id = as.integer(AREA_SHORT_CODE)) |>
left_join(ward_bins, by = "ward_id") |>
ggplot() +
geom_sf(fill = "grey95", colour = "grey60") +
stat_sf_coordinates(aes(size = mean_bins), alpha = 0.7) +
scale_size_area(max_size = 12) +
theme_void() +
labs(size = "Mean bins compromised")
wards |>
mutate(ward_id = as.integer(AREA_SHORT_CODE)) |>
left_join(ward_bins, by = "ward_id") |>
mutate(band = cut(mean_bins, breaks = 3,
labels = c("Low", "Medium", "High"))) |>
ggplot() +
geom_sf(fill = "grey95", colour = "grey60") +
stat_sf_coordinates(aes(size = mean_bins, colour = band), alpha = 0.8) +
scale_size(range = c(2, 18)) +
scale_colour_viridis_d() +
theme_void() +
labs(size = "Mean bins compromised", colour = "Band")
wards |>
mutate(ward_id = as.integer(AREA_SHORT_CODE)) |>
left_join(ward_bins, by = "ward_id") |>
mutate(band = cut(mean_bins, breaks = 3,
